---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppRow from "../../components/AppRow.astro";
import CategoryIcon from "../../components/CategoryIcon.astro";
import { apps, installerVerifiedApps, sourceConfirmedApps } from "../../data/apps";
import { categories } from "../../data/categories";
import { formatKoreanDate } from "../../lib/format";
import { withBase } from "../../lib/paths";

const recentChecks = [...sourceConfirmedApps]
  .sort((left, right) => (right.sourceCheckedAt ?? "").localeCompare(left.sourceCheckedAt ?? ""))
  .slice(0, 5);
---

<BaseLayout>
  <section class="home-intro shell">
    <div class="home-intro__copy">
      <h1>
        <span class="home-intro__title-line">광고 없는 도구,</span>
        <span class="home-intro__title-line home-intro__accent">공식 경로로.</span>
      </h1>
      <p>공식 출처가 확인된 앱과 아직 출처를 검토 중인 후보를 나눠 보여드립니다. 확인 날짜와 Windows 설치 검증 상태도 함께 기록합니다.</p>
      <form class="home-search" data-home-search>
        <label for="home-query">용도로 찾기</label>
        <div class="catalog-search__field home-search__field">
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
          <input id="home-query" type="search" autocomplete="off" placeholder="예: 압축, PDF" data-home-query />
          <button type="submit">후보 찾기</button>
        </div>
        <p>앱 이름을 몰라도 하려는 일로 찾을 수 있습니다.</p>
      </form>
      <div class="home-intro__links">
        <a class="text-link" href={withBase("updates/")}>검증 기록 보기</a>
        <a class="text-link" href={withBase("methodology/")}>선정 기준 보기</a>
      </div>
    </div>
    <aside class="scope-ledger" aria-label="현재 검증 현황">
      <div class="discovery-art" aria-hidden="true"><span class="discovery-art__tile">Aa<span>텍스트 편집</span></span><span class="discovery-art__tile">.zip<span>압축 · 파일</span></span><span class="discovery-art__tile">▶<span>동영상 · 음악</span></span></div>
      <div class="scope-ledger__title">
        <h2>현재 검증 현황</h2>
        <span>{formatKoreanDate(apps.map((app) => app.sourceCheckedAt ?? "").sort().at(-1) ?? null)} 기준</span>
      </div>
      <dl>
        <div><dt>검토 대상</dt><dd>{apps.length}개</dd></div>
        <div><dt>공식 출처 확인</dt><dd>{sourceConfirmedApps.length}개</dd></div>
        <div><dt>Windows 설치 검증 완료</dt><dd>{installerVerifiedApps.length}개</dd></div>
      </dl>
      <p>Windows에서 설치 과정을 직접 확인한 뒤 완료로 표시합니다.</p>
    </aside>
  </section>

  <section class="catalog-section shell" id="catalog" aria-labelledby="catalog-title">
    <header class="section-heading section-heading--catalog">
      <div>
        <h2 id="catalog-title">용도로 찾기</h2>
        <p>앱 이름을 몰라도 하려는 일로 찾을 수 있습니다.</p>
      </div>
      <p class="catalog-count" aria-live="polite">후보 <strong data-result-count>{apps.length}</strong>개</p>
    </header>

    <form class="catalog-controls" data-catalog-form>
      <div class="catalog-search">
        <label for="catalog-query">앱 이름 또는 용도</label>
        <div class="catalog-search__field">
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
          <input id="catalog-query" name="q" type="search" autocomplete="off" placeholder="예: 압축, PDF" data-catalog-query />
          <button type="button" data-catalog-reset>초기화</button>
        </div>
        <p class="field-help">입력하는 즉시 현재 목록에서 찾습니다.</p>
      </div>
      <div class="filter-group">
        <p class="filter-label" id="category-filter-label">카테고리</p>
        <div class="filter-chips" role="group" aria-labelledby="category-filter-label">
          <button type="button" aria-pressed="true" data-category-filter="all">전체</button>
          {categories.map((category) => (
            <button type="button" aria-pressed="false" data-category-filter={category.id}>{category.label}</button>
          ))}
        </div>
      </div>
      <div class="category-select-filter">
        <label for="category-select">카테고리</label>
        <select id="category-select" data-category-select>
          <option value="all">전체</option>
          {categories.map((category) => <option value={category.id}>{category.label}</option>)}
        </select>
      </div>
      <div class="compact-filters">
        <label>
          <span>출처 상태</span>
          <select name="source" data-source-filter>
            <option value="all">전체</option>
            <option value="confirmed">공식 출처 확인</option>
            <option value="pending">출처 검토 중</option>
          </select>
        </label>
        <label class="check-filter">
          <input type="checkbox" data-portable-filter />
          <span>포터블 제공 후보만</span>
        </label>
      </div>
    </form>

    <div class="app-list" data-app-list>
      {apps.map((app) => <AppRow app={app} />)}
    </div>
    <div class="catalog-empty" data-catalog-empty hidden>
      <h3>조건에 맞는 후보가 없습니다.</h3>
      <p>검색어를 줄이거나 출처·포터블 필터를 초기화해 보세요.</p>
      <button type="button" class="outline-action" data-catalog-reset>전체 후보 보기</button>
    </div>
  </section>

  <section class="category-index shell" aria-labelledby="category-title">
    <header class="section-heading">
      <h2 id="category-title">10가지 용도</h2>
      <p>각 용도에서 대표 후보를 검토하고 새 도구를 추가합니다.</p>
    </header>
    <div class="category-index__grid">
      {categories.map((category) => {
        const count = apps.filter((app) => app.category === category.id).length;
        return (
          <a href={`?category=${category.id}#catalog`}>
            <span class="category-index__icon" aria-hidden="true"><CategoryIcon category={category.id} /></span>
            <span>{category.label}</span>
            <small>{category.description}</small>
            <strong>{count}개</strong>
          </a>
        );
      })}
    </div>
  </section>

  <section class="recent-section shell" aria-labelledby="recent-title">
    <header class="section-heading section-heading--split">
      <div>
        <h2 id="recent-title">최근 확인한 출처</h2>
        <p>사람이 공식 페이지를 직접 확인한 최근 기록입니다.</p>
      </div>
      <a class="text-link" href={withBase("updates/")}>전체 검증 기록</a>
    </header>
    <div class="recent-list">
      {recentChecks.map((app) => (
        <a href={withBase(`apps/${app.slug}/`)}>
          <strong>{app.name}</strong>
          <span>{app.stableVersion ? `안정판 버전 ${app.stableVersion}` : "버전 확인 대기"}</span>
          <time datetime={app.sourceCheckedAt ?? undefined}>{formatKoreanDate(app.sourceCheckedAt)}</time>
        </a>
      ))}
    </div>
  </section>

  <section class="guide-callout shell" aria-labelledby="guide-title">
    <div>
      <h2 id="guide-title">검색 결과 맨 위의 사이트가 공식 사이트라는 보장은 없습니다.</h2>
      <p>비슷한 이름의 도메인, 다운로드 버튼처럼 보이는 광고, 설치 파일 재포장 사이트를 구분하는 네 가지 기준을 정리했습니다.</p>
    </div>
    <a class="outline-action" href={withBase("guides/official-downloads/")}>공식 주소 확인법</a>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>("[data-catalog-form]");
    const homeForm = document.querySelector<HTMLFormElement>("[data-home-search]");
    const homeQuery = document.querySelector<HTMLInputElement>("[data-home-query]");
    const queryInput = document.querySelector<HTMLInputElement>("[data-catalog-query]");
    const sourceSelect = document.querySelector<HTMLSelectElement>("[data-source-filter]");
    const portableInput = document.querySelector<HTMLInputElement>("[data-portable-filter]");
    const categorySelect = document.querySelector<HTMLSelectElement>("[data-category-select]");
    const categoryButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-category-filter]"));
    const items = Array.from(document.querySelectorAll<HTMLElement>("[data-catalog-item]"));
    const resultCount = document.querySelector<HTMLElement>("[data-result-count]");
    const empty = document.querySelector<HTMLElement>("[data-catalog-empty]");
    let category = "all";

    const normalize = (value: string) => value.normalize("NFKC").toLocaleLowerCase("ko-KR").trim();
    const setCategory = (next: string) => {
      category = next;
      categoryButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.categoryFilter === category)));
      if (categorySelect) categorySelect.value = category;
    };
    const applyFilters = () => {
      const query = normalize(queryInput?.value ?? "");
      const source = sourceSelect?.value ?? "all";
      const portableOnly = portableInput?.checked ?? false;
      let visible = 0;

      items.forEach((item) => {
        const matchesQuery = !query || normalize(item.dataset.search ?? "").includes(query);
        const matchesCategory = category === "all" || item.dataset.category === category;
        const matchesSource = source === "all" || item.dataset.source === source;
        const matchesPortable = !portableOnly || item.dataset.portable === "yes";
        const matches = matchesQuery && matchesCategory && matchesSource && matchesPortable;
        item.hidden = !matches;
        if (matches) visible += 1;
      });

      if (resultCount) resultCount.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;

      const params = new URLSearchParams();
      if (query) params.set("q", queryInput?.value.trim() ?? "");
      if (category !== "all") params.set("category", category);
      if (source !== "all") params.set("source", source);
      if (portableOnly) params.set("portable", "1");
      const url = `${window.location.pathname}${params.size ? `?${params}` : ""}`;
      history.replaceState(null, "", url);
    };
    const reset = () => {
      form?.reset();
      if (homeQuery) homeQuery.value = "";
      setCategory("all");
      applyFilters();
      queryInput?.focus({ preventScroll: true });
    };

    categoryButtons.forEach((button) => button.addEventListener("click", () => {
      setCategory(button.dataset.categoryFilter ?? "all");
      applyFilters();
    }));
    categorySelect?.addEventListener("change", () => {
      setCategory(categorySelect.value);
      applyFilters();
    });
    queryInput?.addEventListener("input", () => {
      if (homeQuery) homeQuery.value = queryInput.value;
      applyFilters();
    });
    sourceSelect?.addEventListener("change", applyFilters);
    portableInput?.addEventListener("change", applyFilters);
    document.querySelectorAll("[data-catalog-reset]").forEach((button) => button.addEventListener("click", reset));
    form?.addEventListener("submit", (event) => event.preventDefault());
    homeForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (queryInput) queryInput.value = homeQuery?.value ?? "";
      applyFilters();
      document.querySelector("#catalog")?.scrollIntoView();
      queryInput?.focus({ preventScroll: true });
    });

    const params = new URLSearchParams(window.location.search);
    const initialCategory = params.get("category") ?? "all";
    if (categoryButtons.some((button) => button.dataset.categoryFilter === initialCategory) || categorySelect?.querySelector(`option[value="${CSS.escape(initialCategory)}"]`)) setCategory(initialCategory);
    if (queryInput) queryInput.value = params.get("q") ?? "";
    if (homeQuery) homeQuery.value = params.get("q") ?? "";
    if (sourceSelect && ["confirmed", "pending"].includes(params.get("source") ?? "")) sourceSelect.value = params.get("source") ?? "all";
    if (portableInput) portableInput.checked = params.get("portable") === "1";
    applyFilters();
  </script>
</BaseLayout>
