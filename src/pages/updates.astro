---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { apps, sourceConfirmedApps } from "../data/apps";
import { categoryById } from "../data/categories";
import { formatKoreanDate } from "../lib/format";
import { withBase } from "../lib/paths";

const checked = [...sourceConfirmedApps].sort((a, b) => (b.sourceCheckedAt ?? "").localeCompare(a.sourceCheckedAt ?? ""));
const pending = apps.filter((app) => app.sourceStatus === "pending");
---

<BaseLayout title="업데이트" description="공식 다운로드 출처와 버전 확인 기록">
  <article class="text-page shell">
    <header class="text-page__header">
      <h1>무엇을 언제 확인했는지</h1>
      <p>버전 숫자보다 확인 과정이 먼저입니다. 자동 점검은 변화를 알려주고, 공개 상태는 사람이 공식 출처를 살핀 뒤 바뀝니다.</p>
    </header>
    <section class="change-log" aria-labelledby="checked-title">
      <header class="section-heading section-heading--split">
        <div><h2 id="checked-title">공식 출처 확인</h2><p>{checked.length}개 후보의 공식 배포 경로를 확인했습니다.</p></div>
        <StatusBadge status="confirmed" />
      </header>
      <div class="change-log__rows">
        {checked.map((app) => (
          <a href={withBase(`apps/${app.slug}/`)}>
            <time datetime={app.sourceCheckedAt ?? undefined}>{formatKoreanDate(app.sourceCheckedAt)}</time>
            <strong>{app.name}</strong>
            <span>{categoryById[app.category].label}</span>
            <span>{app.stableVersion ? `안정판 버전 ${app.stableVersion}` : "버전 확인 대기"}</span>
          </a>
        ))}
      </div>
    </section>
    <section class="pending-queue" aria-labelledby="pending-title">
      <header class="section-heading"><h2 id="pending-title">출처 검토 중</h2><p>아래 링크는 후보 출처이며, 아직 공식 출처로 확인하지 않았습니다.</p></header>
      <ul>
        {pending.map((app) => <li><a href={withBase(`apps/${app.slug}/`)}>{app.name}</a><span>{categoryById[app.category].label}</span></li>)}
      </ul>
    </section>
  </article>
</BaseLayout>
