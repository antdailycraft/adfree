---
import { apps } from "../data/apps";
import { categoryById } from "../data/categories";
import { withBase } from "../lib/paths";
import { createSearchText } from "../lib/search";

const searchIndex = apps.map((app) => ({
  name: app.name,
  summary: app.summary,
  category: categoryById[app.category].label,
  href: withBase(`apps/${app.slug}/`),
  sourceStatus: app.sourceStatus,
  searchText: createSearchText(app, categoryById[app.category]),
}));
---

<dialog class="command-dialog" data-command-dialog aria-labelledby="command-title">
  <div class="command-dialog__frame">
    <div class="command-dialog__field">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <label class="sr-only" for="command-input" id="command-title">앱 검색</label>
      <input id="command-input" type="search" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="command-results" aria-describedby="command-hint" autocomplete="off" placeholder="예: 압축, PDF, ShareX" data-command-input />
      <button type="button" class="command-dialog__close" data-command-close aria-label="검색 닫기">닫기</button>
    </div>
    <p class="command-dialog__hint" id="command-hint">앱 이름과 용도로 검색합니다. 위·아래 방향키로 이동할 수 있습니다.</p>
    <p class="sr-only" role="status" data-command-count></p>
    <div id="command-results" class="command-dialog__results" role="listbox" aria-label="앱 검색 결과" data-command-results></div>
  </div>
</dialog>

<script type="application/json" id="app-search-data" is:inline set:html={JSON.stringify(searchIndex).replace(/</g, "\\u003c")} />
<script>
  import { matchesSearch, searchRank } from "../lib/search";
  interface SearchItem {
    name: string;
    category: string;
    href: string;
    sourceStatus: string;
    searchText: string;
  }
  const dialog = document.querySelector<HTMLDialogElement>("[data-command-dialog]");
  const input = document.querySelector<HTMLInputElement>("[data-command-input]");
  const results = document.querySelector<HTMLElement>("[data-command-results]");
  const source = document.querySelector<HTMLScriptElement>("#app-search-data");
  const index: SearchItem[] = source ? JSON.parse(source.textContent || "[]") : [];
  const count = document.querySelector<HTMLElement>("[data-command-count]");
  let activeIndex = 0;

  const visibleResults = () => Array.from(results?.querySelectorAll<HTMLAnchorElement>("a") ?? []);

  const render = () => {
    if (!results || !input) return;
    const query = input.value;
    const matches = index
      .filter((item) => matchesSearch(item.searchText, query))
      .sort((left, right) => searchRank(right.name, query) - searchRank(left.name, query));
    activeIndex = 0;
    input.removeAttribute("aria-activedescendant");
    if (count) count.textContent = `검색 결과 ${matches.length}개`;
    results.replaceChildren();
    results.scrollTop = 0;

    if (matches.length === 0) {
      const empty = document.createElement("p");
      empty.className = "command-dialog__empty";
      empty.textContent = "일치하는 후보가 없습니다. 다른 용도나 앱 이름으로 검색해 보세요.";
      results.append(empty);
      return;
    }

    matches.forEach((item, itemIndex) => {
      const link = document.createElement("a");
      link.href = item.href;
      link.id = `command-option-${itemIndex}`;
      link.setAttribute("role", "option");
      link.tabIndex = -1;
      const identity = document.createElement("span");
      const name = document.createElement("strong");
      name.textContent = item.name;
      const category = document.createElement("small");
      category.textContent = item.category;
      identity.append(name, category);
      const status = document.createElement("span");
      status.className = "command-dialog__status";
      status.textContent = item.sourceStatus === "confirmed" ? "공식 출처 확인" : "출처 검토 중";
      link.append(identity, status);
      results.append(link);
    });
    setActive(0);
  };

  const setActive = (next: number) => {
    const items = visibleResults();
    if (!items.length) return;
    activeIndex = (next + items.length) % items.length;
    items.forEach((item, itemIndex) => {
      const active = itemIndex === activeIndex;
      item.classList.toggle("is-active", active);
      item.setAttribute("aria-selected", String(active));
    });
    input?.setAttribute("aria-activedescendant", items[activeIndex]!.id);
    items[activeIndex]?.scrollIntoView({ block: "nearest" });
  };

  const open = () => {
    if (!dialog || !input || dialog.open) return;
    dialog.showModal();
    input.setAttribute("aria-expanded", "true");
    input.value = "";
    activeIndex = 0;
    render();
    requestAnimationFrame(() => input.focus());
  };

  const resetDialogState = () => {
    input?.setAttribute("aria-expanded", "false");
    input?.removeAttribute("aria-activedescendant");
  };

  const close = () => {
    if (!dialog?.open) return;
    resetDialogState();
    dialog.close();
  };

  document.querySelectorAll("[data-command-open]").forEach((trigger) => trigger.addEventListener("click", open));
  document.querySelectorAll("[data-command-close]").forEach((trigger) => trigger.addEventListener("click", close));
  input?.addEventListener("input", render);
  input?.addEventListener("keydown", (event) => {
    if (event.isComposing) return;
    if (event.key === "Escape") {
      event.preventDefault();
      close();
      return;
    }
    if (event.key === "ArrowDown") {
      event.preventDefault();
      setActive(activeIndex + 1);
    }
    if (event.key === "ArrowUp") {
      event.preventDefault();
      setActive(activeIndex - 1);
    }
    if (event.key === "Enter") {
      const selected = visibleResults()[activeIndex];
      if (selected) {
        event.preventDefault();
        selected.click();
      }
    }
  });
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLocaleLowerCase() === "k") {
      event.preventDefault();
      dialog?.open ? close() : open();
    }
  });
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) close();
  });
  dialog?.addEventListener("close", () => {
    // Native modal dialogs block background interaction; avoid mutating its inert state.
    // A queued close event may arrive after the user has already reopened the dialog.
    if (!dialog.open) resetDialogState();
  });
</script>
