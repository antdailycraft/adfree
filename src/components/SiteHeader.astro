---
import { withBase } from "../lib/paths";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const links = [
  { href: withBase("apps/"), label: "도구 탐색" },
  { href: withBase("updates/"), label: "업데이트" },
  { href: withBase("methodology/"), label: "검증 기준" },
  { href: withBase("guides/official-downloads/"), label: "가이드" },
];
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="wordmark" href={withBase()} aria-label="Adfree 홈">Adfree<span aria-hidden="true">.</span></a>
    <button class="search-pill" type="button" data-command-open aria-haspopup="dialog">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <span class="search-pill__label">앱 검색</span>
      <span class="search-pill__keys" aria-hidden="true"><kbd>⌘</kbd><kbd>K</kbd></span>
    </button>
    <nav class="desktop-nav" aria-label="주요 메뉴">
      {links.map((link) => (
        <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>{link.label}</a>
      ))}
    </nav>
    <details class="mobile-menu">
      <summary>메뉴</summary>
      <nav aria-label="모바일 메뉴">
        {links.map((link) => <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>{link.label}</a>)}
      </nav>
    </details>
  </div>
</header>
