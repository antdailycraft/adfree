---
import Comments from "../../components/Comments.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import AdfreeEmblem from "../../components/AdfreeEmblem.astro";
import PlatformBadges from "../../components/PlatformBadges.astro";
import { appMedia } from "../../data/app-media";
import { apps, type AppRecord } from "../../data/apps";
import { categoryById } from "../../data/categories";
import { formatKoreanDate, portableLabel } from "../../lib/format";
import { withBase } from "../../lib/paths";

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

interface Props { app: AppRecord }
const { app } = Astro.props;
const host = new URL(app.downloadPage).hostname.replace(/^www\./, "");
const sourceConfirmed = app.sourceStatus === "confirmed";
const media = appMedia[app.slug];
---

<BaseLayout title={app.name} description={`${app.name} 다운로드 경로와 Adfree 검증 상태`}>
  <article class="detail-page shell">
    <nav class="breadcrumb" aria-label="현재 위치">
      <a href={withBase()}>홈</a><span aria-hidden="true">/</span><a href={`${withBase("apps/")}?category=${app.category}#catalog`}>{categoryById[app.category].label}</a><span aria-hidden="true">/</span><span aria-current="page">{app.name}</span>
    </nav>
    <header class="detail-header">
      <div>
        <p class="detail-header__category">{categoryById[app.category].label}</p>
        <div class="product-title">
          {media?.logo && <img src={withBase(media.logo.src)} alt="" width="64" height="64" decoding="async" />}
          <h1>{app.name}</h1>
        </div>
        <PlatformBadges slug={app.slug} />
        <AdfreeEmblem app={app} />
        <p class="detail-header__summary">{app.summary}</p>
      </div>
      <div class="detail-header__actions">
        <a class="text-link" href="#verification-title">검증 기록 먼저 보기</a>
        <a class="primary-action" href={app.downloadPage} rel="noopener noreferrer">
          {sourceConfirmed ? "공식 다운로드 페이지" : "후보 출처 열기 · 검토 중"}
        </a>
        <a class="text-link" href={app.homepage} rel="noopener noreferrer">
          {sourceConfirmed ? "공식 홈페이지" : "후보 홈페이지 열기 · 검토 중"}
        </a>
      </div>
    </header>

    {media?.screenshot && <figure class="product-preview">
      <a href={withBase(media.screenshot.src)} aria-label={`${app.name} 대표 화면 원본 크기로 보기`}>
        <img src={withBase(media.screenshot.src)} alt={media.screenshot.alt} width={media.screenshot.width} height={media.screenshot.height} loading="lazy" decoding="async" />
      </a>
      <figcaption>
        <strong>대표 화면</strong>
        {media.screenshot.caption && <span>{media.screenshot.caption}</span>}
        <span>공식 소개 자료 · 현재 버전이나 사용 OS에 따라 다를 수 있습니다. 설치 검증 화면은 아닙니다.</span>
        <a class="text-link" href={media.screenshot.source} rel="noopener noreferrer">이미지 출처</a>
        {app.slug === "mobaxterm" && <span>This document originates from the website "mobaxterm.mobatek.net". Reproduction rights are reserved and strictly limited.</span>}
      </figcaption>
    </figure>}

    <section class="verification-panel" aria-labelledby="verification-title">
      <div class="verification-panel__intro">
        <h2 id="verification-title">검증 기록</h2>
        <p>{app.editorNote}</p>
      </div>
      <div class="verification-panel__states">
        {app.adFreeReview && (
          <div id="adfree-review">
            <h3>무광고 공식 안내 확인</h3>
            <p>{formatKoreanDate(app.adFreeReview.checkedAt)} 확인. {app.adFreeReview.scope}</p>
            <a class="text-link" href={app.adFreeReview.evidence} rel="noopener noreferrer">개발사의 무광고 안내 보기</a>
          </div>
        )}
        <div>
          <StatusBadge status={app.sourceStatus} />
          <p>{app.sourceStatus === "confirmed" ? `${formatKoreanDate(app.sourceCheckedAt)}에 공식 출처를 확인했습니다.` : "후보 도메인과 배포 주체의 관계를 검토하고 있습니다."}</p>
        </div>
        <div>
          <StatusBadge status={app.installerStatus} type="installer" />
          <p>{app.installerStatus === "verified" ? `${formatKoreanDate(app.installerCheckedAt)}에 Windows 설치 과정을 확인했습니다.` : "Windows에서 설치기와 첫 실행을 확인하지 않아 광고나 제휴 프로그램 동반 설치 여부를 아직 판단하지 않았습니다."}</p>
        </div>
      </div>
    </section>

    <section class="spec-section" aria-labelledby="spec-title">
      <header class="section-heading"><h2 id="spec-title">확인 항목</h2></header>
      <dl class="detail-spec">
        {media && <div><dt>지원 OS</dt><dd><PlatformBadges slug={app.slug} /></dd><p>{media.platformNote} <a href={media.platformSource} rel="noopener noreferrer">공식 안내</a></p></div>}
        <div><dt>{sourceConfirmed ? "공식 도메인" : "후보 도메인 · 출처 검토 중"}</dt><dd>{host}</dd><p>{sourceConfirmed ? "확인된" : "검토 대상"} 도메인 {app.officialHosts.join(", ")}</p></div>
        <div><dt>안정판 버전</dt><dd>{app.stableVersion ?? "버전 확인 대기"}</dd><p>{app.releaseDate ? `${formatKoreanDate(app.releaseDate)} 공개` : "공식 안정판 정보를 확인 중입니다."}</p></div>
        <div><dt>라이선스</dt><dd>{app.license}</dd><p>{app.commercialUse}</p></div>
        <div><dt>계정</dt><dd>{app.accountRequired ? "필요" : "불필요"}</dd><p>앱의 기본 기능을 사용할 때를 기준으로 확인합니다.</p></div>
        <div><dt>포터블</dt><dd>{portableLabel[app.portable]}</dd><p>설치 없이 실행 가능한 배포판 여부</p></div>
        <div><dt>새 버전 감지 경로</dt><dd>{app.releaseSource.kind === "github" ? "GitHub 안정판" : "공식 페이지"}</dd><p>변경 여부만 자동으로 감지하고, 사이트의 검증 상태는 사람이 확인한 뒤 바꿉니다.</p></div>
      </dl>
    </section>

    <section class="evidence-section" aria-labelledby="evidence-title">
      <header class="section-heading"><h2 id="evidence-title">근거와 주의사항</h2></header>
      {app.sourceEvidence.length > 0 ? (
        <ul class="evidence-list">
          {app.sourceEvidence.map((evidence) => <li><a href={evidence} rel="noopener noreferrer">{new URL(evidence).hostname.replace(/^www\./, "")}</a></li>)}
        </ul>
      ) : (
        <p class="pending-note">아직 공식 출처로 확인한 근거 링크가 없습니다. 다운로드하려면 개발사나 프로젝트가 밝힌 도메인인지 먼저 직접 확인하세요.</p>
      )}
      <p class="detail-caution">Adfree는 설치 파일을 보관하거나 재배포하지 않습니다. 이 기록은 바이러스 검사나 독립 보안 감사를 대신하지 않습니다.</p>
      {media?.logo && <p class="detail-caution">제품 로고·아이콘은 해당 권리자의 자산이며 제품 식별을 위해 표시합니다. <a href={media.logo.source} rel="noopener noreferrer">로고 출처</a></p>}
    </section>
    <Comments path={`/apps/${app.slug}/`} title={app.name} />
  </article>
</BaseLayout>

<style>
  .product-title { display: flex; align-items: center; gap: 1rem; }
  .product-title img { width: 4rem; height: 4rem; object-fit: contain; flex: none; }
  .product-title h1 { min-width: 0; overflow-wrap: anywhere; }
  .product-preview { margin: 0 0 2.5rem; }
  .product-preview > a { display: block; border: 1px solid var(--color-rule); border-radius: 12px; background: var(--color-paper-2); overflow: hidden; }
  .product-preview img { display: block; width: 100%; height: auto; max-height: 36rem; object-fit: contain; }
  .product-preview figcaption { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem 1rem; margin-top: .75rem; font-size: .8125rem; color: var(--color-ink-soft); }
  @media (max-width: 30rem) { .product-title img { width: 3rem; height: 3rem; } }
</style>
