    <div class="site-footer__meta">
      <p>설치 파일을 재배포하지 않습니다.</p>
      <nav aria-label="하단 메뉴">
        <a href={withBase("methodology/")}>검증 기준</a>
        <a href={withBase("updates/")}>변경 기록</a>
        <a href="https://github.com/antdailycraft/adfree">GitHub</a>
      </nav>
