---
import type { AppRecord } from "../data/apps";
import { withBase } from "../lib/paths";
interface Props { app: AppRecord }
const { app } = Astro.props;
const show = app.adFreeReview?.basis === "official_statement"
  && app.sourceStatus === "confirmed" && app.installerStatus !== "failed";
---
{show && (
  <a class="adfree-emblem" href={`${withBase(`apps/${app.slug}/`)}#adfree-review`} aria-label={`${app.name}: Adfree 무광고 공식 안내 확인, 근거 보기`}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9" /><path d="m8 12 3 3 5-6" />
    </svg>
    <strong>Adfree</strong><span>무광고 · 공식 안내 확인</span>
  </a>
)}
<style>
  .adfree-emblem {
    display: inline-flex; align-items: center; flex-wrap: wrap; gap: .4rem;
    width: fit-content; max-width: 100%; padding: .5rem .7rem;
    border: 1px solid #a6d9c2; border-radius: .5rem;
    background: #edf8f2; color: #12573a; font-size: .75rem;
    line-height: 1.5; text-decoration: none;
  }
  .adfree-emblem svg { flex: none; }
  .adfree-emblem strong { font-size: .875rem; }
  .adfree-emblem:hover { background: #dcefe4; }
  .adfree-emblem:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
</style>
